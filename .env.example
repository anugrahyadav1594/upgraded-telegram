# =====================================================================================
# REALCHAT — environment template.
#
#   cp .env.example .env      # then replace every CHANGE_ME value
#
# This file is read by Docker Compose (`docker compose --env-file .env ...`). Spring Boot does NOT
# read it: the backend container receives these values as environment variables, and a backend you
# run yourself (`./mvnw spring-boot:run`) needs them exported in your shell. See RUNNING.md.
#
# Nothing here is a real secret. `.env` is git-ignored; this template is committed and must stay
# placeholder-only. The production profile refuses to start with placeholder values still in place
# (see backend/src/main/java/com/realtimechat/config/ProductionReadinessValidator.java).
# =====================================================================================

# -------------------------------------------------------------------------------------
# Deployment shape
# -------------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker          # dev | docker | prod
SERVER_PORT=8080
# Host port the edge nginx publishes. Open http://localhost:${HTTP_PORT} in a browser.
HTTP_PORT=8080
# Public URL of the app — used to build password-reset links. Must match what users actually visit.
APP_PUBLIC_URL=http://localhost:8080
# Origins allowed to send credentialed requests / open a WebSocket. Comma-separated, never `*`.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# -------------------------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------------------------
POSTGRES_USER=realtime_chat
POSTGRES_DB=realtime_chat
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Host port for the database, published on 127.0.0.1 only (for local development tooling).
POSTGRES_HOST_PORT=5432
# Connection string used *inside* the compose network — note the service name, not localhost.
DATABASE_URL=jdbc:postgresql://postgres:5432/realtime_chat
DATABASE_USERNAME=realtime_chat
DATABASE_PASSWORD=CHANGE_ME_postgres_password
DATABASE_POOL_SIZE=10

# -------------------------------------------------------------------------------------
# Redis (presence, typing, rate limits, session cache)
# -------------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
# Host port for Redis, published on 127.0.0.1 only.
REDIS_HOST_PORT=6379

# -------------------------------------------------------------------------------------
# Sessions & cookies
# -------------------------------------------------------------------------------------
# Signs CSRF tokens and pagination cursors. Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# true in production (HTTPS only). Leave false for the default http://localhost quick start.
SESSION_COOKIE_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_IDLE_TIMEOUT=7d
SESSION_ABSOLUTE_TIMEOUT=30d

# -------------------------------------------------------------------------------------
# Email (password reset). With MAIL_ENABLED=false the link is written to the application log,
# which is convenient locally and never acceptable in production.
# -------------------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@realtime-chat.local

# -------------------------------------------------------------------------------------
# Development seed (development only)
# -------------------------------------------------------------------------------------
# Creating the demo accounts (@alex, @ghost, @developer, @testuser) requires an explicit opt-in.
# The application refuses to start in the `prod` profile while this is true.
DEV_SEED_ENABLED=false

# The password you will TYPE at the sign-in screen for those accounts (≥ 12 characters).
# It is only an input for the generator below — the application never reads it, and it is never
# stored anywhere: the database only ever sees SEED_PASSWORD_HASH.
DEV_SEED_PASSWORD=CHANGE_ME_dev_seed_password_at_least_12_chars

# SEED_PASSWORD_HASH is an Argon2id PHC string — the hashed form of DEV_SEED_PASSWORD:
#   $argon2id$v=19$m=19456,t=2,p=1$<16-byte salt, base64>$<32-byte hash, base64>
# Generate it with the backend image, which uses the same encoder that verifies logins, and paste the
# single line it prints below (this is what makes the seed safe to commit-aware: no plaintext):
#   docker compose -f infrastructure/docker-compose.yml --env-file .env \
#     run --rm --entrypoint sh backend -c 'java -jar /app/app.jar --hash-password "$DEV_SEED_PASSWORD"'
# Then apply the seed:
#   docker compose -f infrastructure/docker-compose.yml --env-file .env --profile seed run --rm seed
SEED_PASSWORD_HASH=

# -------------------------------------------------------------------------------------
# Limits & logging
# -------------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
OPENAPI_ENABLED=true

# -------------------------------------------------------------------------------------
# Frontend build (only needed for a split-origin deployment; leave empty for same-origin)
# -------------------------------------------------------------------------------------
VITE_API_BASE=
