# Development defaults. Copy to .env.local and adjust if your backend is not on localhost:8080.
# The Vite dev server proxies /api and /ws to this URL, so the browser only ever talks to one origin.
VITE_BACKEND_URL=http://localhost:8080

# Optional: absolute API base for a deployment where the frontend is served from a different origin.
# Leave empty in the recommended same-origin (nginx reverse proxy) deployment.
VITE_API_BASE=
